# Production receivers (rendered by the IaC on mon-c; ${…} values come from SOPS-encrypted variables, never from git).
# Same route tree as alertmanager.yml. Channels are chosen by the operating team and listed as sub-processors.
global:
  smtp_smarthost: ${SMTP_SMARTHOST}
  smtp_from: ${ALERT_FROM}
  smtp_auth_username: ${SMTP_USER}
  smtp_auth_password_file: /run/secrets/smtp_password
  smtp_require_tls: true
receivers:
  - name: heartbeat
    webhook_configs:
      - url: https://${STATUS_HOST}/v1/heartbeat
        send_resolved: false
        http_config: {authorization: {type: Bearer, credentials_file: /run/secrets/heartbeat_token}}
  - name: maintainers-critical
    email_configs: [{to: "${MAINTAINERS_EMAIL}", send_resolved: true}]
    webhook_configs: [{url_file: /run/secrets/chat_webhook_url, send_resolved: true}]
  - name: maintainers-warning
    email_configs: [{to: "${MAINTAINERS_EMAIL}", send_resolved: false}]
    webhook_configs: [{url_file: /run/secrets/ops_issue_webhook_url, send_resolved: false}]
  - name: security-responders
    email_configs: [{to: "${SECURITY_RESPONDERS_EMAIL}", send_resolved: true}]
    webhook_configs: [{url_file: /run/secrets/security_push_webhook_url, send_resolved: true}]
  - name: portal-notices
    webhook_configs: [{url: "https://${CONTROL_PLANE_INTERNAL}/internal/v1/notices", send_resolved: true,
      http_config: {tls_config: {ca_file: /run/secrets/scf_ca, cert_file: /run/secrets/mon_c_cert, key_file: /run/secrets/mon_c_key}}}]
  - name: blackhole
