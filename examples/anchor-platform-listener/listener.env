# SPDX-License-Identifier: Apache-2.0
# Environment of tools/ap-listener next to Anchor Platform 5.x. Values from your platform's config and the portal.
# Your Anchor Platform's Kafka (events.queue.kafka.bootstrap_server); the listener uses its own consumer group.
AP_KAFKA_BROKERS=127.0.0.1:9092
AP_KAFKA_TOPIC=TRANSACTION
AP_KAFKA_GROUP=usagemap-ap-listener
STELLAR_NETWORK=testnet
# UsageMap: the API service registered in the portal (Project → API services) and its ingest endpoint.
OTEL_SERVICE_NAME=my-anchor-events
OTEL_EXPORTER_OTLP_ENDPOINT=https://e1.usagemap.dev
# The ingest token is a secret: export OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20scfa_ing_… in your shell
# or secret store instead of writing it here.
