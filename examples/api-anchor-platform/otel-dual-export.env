# SPDX-License-Identifier: Apache-2.0
# Anchor Platform 5.x -> your APM and UsageMap: the agent reads the declarative file ../api-java-spring/otel/sdk.yaml
# (mounted at /otel/sdk.yaml). Add at run time: OTEL_SERVICE_NAME, APM_OTLP_ENDPOINT, APM_API_KEY,
# SCF_OTLP_ENDPOINT=https://ingest.scf.example and SCF_OTLP_TOKEN. Environment OTLP headers are ignored in this mode.
JAVA_TOOL_OPTIONS=-javaagent:/otel/opentelemetry-javaagent.jar
OTEL_CONFIG_FILE=/otel/sdk.yaml
