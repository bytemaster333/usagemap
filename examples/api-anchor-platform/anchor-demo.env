# SPDX-License-Identifier: Apache-2.0
# NOT part of the integration: the smallest Anchor Platform 5.0.0 SEP server our test can start (SEP-1 only, one
# testnet asset, a throwaway PostgreSQL). Your deployment keeps its own configuration; only otel-*.env is added.
# Anchor Platform 5.0.0 ships no H2 or SQLite driver, so a PostgreSQL database is required even for a demo.
DATA_TYPE=postgres
DATA_DATABASE=anchor
DATA_FLYWAY_ENABLED=true
SECRET_DATA_USERNAME=anchor
SECRET_DATA_PASSWORD=anchor
ASSETS_TYPE=json
ASSETS_VALUE={"items":[{"id":"stellar:native","distribution_account":"GA7FYRB5VREZKOBIIKHG5AVTPFGWUBPOBF7LTYG4GTMFVIOOD2DWAL7I","significant_decimals":7}]}
SEP1_ENABLED=true
SEP1_TOML_TYPE=string
SEP1_TOML_VALUE=NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
