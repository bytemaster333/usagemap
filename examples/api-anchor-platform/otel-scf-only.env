# Anchor Platform 5.x -> UsageMap, configuration only: the OpenTelemetry Java agent, configured by environment variables.
# JAVA_TOOL_OPTIONS is read by the JVM itself, whatever the entrypoint (if you already set it, append the flag).
# Run the image with entrypoint `java` and the arguments `-jar /app/anchor-platform-runner.jar --sep-server`: the
# stock start script does not pass SIGTERM on to Java, so the agent's final export would be lost on every restart.
# Add the endpoint and token at run time:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.scf.example
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<your ingest token>
#   OTEL_RESOURCE_ATTRIBUTES=service.instance.id=<one value per replica>
JAVA_TOOL_OPTIONS=-javaagent:/otel/opentelemetry-javaagent.jar
OTEL_SERVICE_NAME=my-anchor
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Without it the agent attaches exemplars carrying client.address, url.query and user_agent.original (measured).
OTEL_METRICS_EXEMPLAR_FILTER=always_off
