{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/*.md",
      "!**/testdata",
      "!scaffold-stellar/app"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.vue", "**/*.svelte", "**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    },
    {
      "includes": ["anchor-platform-listener/sample-event.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
