# UsageMap settings for this project (USAGEMAP.md). Copy what you need:
# the PUBLIC_ lines into app/.env, the others into your shell or CI secrets.

# --- Web + wallet analytics (app/.env) ---
# Public site key from the portal (Project -> Websites). Empty = analytics off, nothing is sent.
PUBLIC_USAGEMAP_SITE=
# "required" when a consent banner must gate analytics (send nothing until consent is given).
PUBLIC_USAGEMAP_CONSENT=

# --- Contract registration by the post-deploy extension (shell or CI; never in app/.env) ---
# Only used when scaffold.yml has extensions.usagemap.register: true.
# The key is a footprint registration key (scfa_reg_...) from the portal page "Register your Stellar contracts":
# it can only add contracts as "claimed" to this one project; it cannot verify, remove or read anything.
USAGEMAP_TENANT_ID=
SCF_FOOTPRINT_KEY=
# USAGEMAP_API_URL=https://app.usagemap.dev

# --- API analytics for a backend, if the project has one (standard OpenTelemetry variables) ---
# The SDK sends http.server.request.duration to UsageMap; nothing else is stored.
# The token is a secret: keep it out of PUBLIC_ variables and out of the browser bundle.
OTEL_SERVICE_NAME=my-dapp-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://e1.usagemap.dev
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20scfa_ing_REPLACE_ME
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=otlp
