# --- UsageMap (append to the template's .env.example; `stellar scaffold init` copies it to .env) ---
# Web + wallet analytics. Public site key from the portal (Project → Websites). Empty = analytics off.
PUBLIC_USAGEMAP_SITE=
# Set to "required" when your consent banner must gate analytics (EU sites that need consent).
PUBLIC_USAGEMAP_CONSENT=

# API analytics for your backend (only if the project has one). Standard OpenTelemetry variables:
# the SDK sends http.server.request.duration to UsageMap; nothing else is stored.
# The token is a secret: keep it out of PUBLIC_ variables and out of the browser bundle.
OTEL_SERVICE_NAME=my-dapp-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://e1.usagemap.dev
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20scfa_ing_REPLACE_ME
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=otlp
