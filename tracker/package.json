{
  "name": "@usagemap/tracker",
  "version": "1.2.0",
  "description": "Pinned, privacy-first browser tracker for the UsageMap web analytics platform (protocol v1).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/npm",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/npm/types/npm.d.ts",
      "default": "./dist/npm/standard.js"
    },
    "./strict": {
      "types": "./dist/npm/types/npm.d.ts",
      "default": "./dist/npm/strict.js"
    },
    "./wallets-kit": {
      "types": "./dist/npm/types/wallets-kit.d.ts",
      "default": "./dist/npm/wallets-kit.js"
    },
    "./wallets": {
      "types": "./dist/npm/types/wallets.d.ts",
      "default": "./dist/npm/wallets.js"
    },
    "./passkey": {
      "types": "./dist/npm/types/passkey.d.ts",
      "default": "./dist/npm/passkey.js"
    },
    "./privy": {
      "types": "./dist/npm/types/privy.d.ts",
      "default": "./dist/npm/privy.js"
    },
    "./stellar-rpc": {
      "types": "./dist/npm/types/stellar-rpc.d.ts",
      "default": "./dist/npm/stellar-rpc.js"
    },
    "./debug": {
      "types": "./dist/npm/types/debug.d.ts",
      "default": "./dist/npm/debug.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "check:output": "node scripts/check-output.ts",
    "verify-reproducible": "node scripts/verify-reproducible.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.ts && playwright test",
    "filter-list-check": "node scripts/filter-list-check.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  }
}
