{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://<domain-a>/schemas/v1/challenge-request.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "s", "p", "tv"],
  "properties": {
    "v": {
      "const": 1
    },
    "s": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{22}$",
      "description": "public site key"
    },
    "p": {
      "enum": ["standard", "strict"],
      "description": "profile the script was built as"
    },
    "tv": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "tracker version"
    }
  }
}
