{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://<domain-a>/schemas/v1/challenge-response.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "t", "pow", "ttl"],
  "properties": {
    "v": {
      "const": 1
    },
    "t": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{123}$",
      "description": "challenge token, §b.1"
    },
    "pow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "cost", "max", "pfx"],
      "properties": {
        "alg": {
          "const": "pbkdf2-sha256"
        },
        "cost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "pfx": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "ttl": {
      "type": "integer",
      "description": "seconds the token is accepted (1800)"
    }
  }
}
