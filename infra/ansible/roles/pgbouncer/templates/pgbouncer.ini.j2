; {{ ansible_managed }}
; PgBouncer on {{ inventory_hostname }}: transaction mode (C-103: tenant context is transaction-local). Server side is
; the local primary-following HAProxy ({{ scf_pgbouncer_server }}), so a Patroni failover needs no reload here.
[databases]
scf = host={{ scf_pgbouncer_server.split(':')[0] }} port={{ scf_pgbouncer_server.split(':')[1] }} dbname=scf
umami = host={{ scf_pgbouncer_server.split(':')[0] }} port={{ scf_pgbouncer_server.split(':')[1] }} dbname=umami

[pgbouncer]
listen_addr = {{ scf_pgbouncer_listen.split(':')[0] }}
listen_port = {{ scf_pgbouncer_listen.split(':')[1] }}
unix_socket_dir =
auth_type = scram-sha-256
auth_file = /etc/pgbouncer-scf/userlist.txt
pool_mode = transaction
default_pool_size = {{ scf_pgbouncer_default_pool_size }}
max_client_conn = {{ scf_pgbouncer_max_client_conn }}
max_prepared_statements = 200
server_reset_query =
ignore_startup_parameters = extra_float_digits,options
; a server connection cut by HAProxy at failover is dropped and replaced on the next transaction
server_check_delay = 5
server_login_retry = 2
; no client addresses in the logs (privacy invariant)
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
stats_period = 60
