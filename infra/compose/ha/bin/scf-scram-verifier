#!/usr/bin/env -S python3 -I
# SPDX-License-Identifier: Apache-2.0
# Read a password on stdin, print its PostgreSQL SCRAM-SHA-256 verifier (RFC 5802/7677, PostgreSQL's
# "SCRAM-SHA-256$<iter>:<salt>$<StoredKey>:<ServerKey>" format). Used so that role passwords reach the server only as
# verifiers, never as clear text (C-114). Passwords are expected to be ASCII (generated secrets), so SASLprep is the
# identity. Standard library only.
import base64
import hashlib
import hmac
import os
import sys

ITERATIONS = 4096  # PostgreSQL's default scram_iterations


def verifier(password: bytes, salt: bytes, iterations: int = ITERATIONS) -> str:
    salted = hashlib.pbkdf2_hmac("sha256", password, salt, iterations)
    client_key = hmac.new(salted, b"Client Key", hashlib.sha256).digest()
    stored_key = hashlib.sha256(client_key).digest()
    server_key = hmac.new(salted, b"Server Key", hashlib.sha256).digest()
    b64 = lambda b: base64.b64encode(b).decode()  # noqa: E731
    return f"SCRAM-SHA-256${iterations}:{b64(salt)}${b64(stored_key)}:{b64(server_key)}"


def main() -> int:
    pw = sys.stdin.buffer.read().rstrip(b"\r\n")
    if not pw or b"\n" in pw:
        print("scf-scram-verifier: need exactly one non-empty line on stdin", file=sys.stderr)
        return 2
    try:
        pw.decode("ascii")
    except UnicodeDecodeError:
        print("scf-scram-verifier: password must be ASCII", file=sys.stderr)
        return 2
    print(verifier(pw, os.urandom(16)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
