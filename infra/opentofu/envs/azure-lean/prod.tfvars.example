# SPDX-License-Identifier: Apache-2.0
# Copy to prod.tfvars (git-ignored) and fill in. Names, keys, addresses and domains below are placeholders (C-98).
subscription_id = "00000000-0000-0000-0000-000000000000"
lean = {
  location           = "westeurope"
  secondary_location = "swedencentral"
  # app_vm         = { size = "Standard_D4as_v5" } # small start; default Standard_D8as_v5 (docs/cost-model.md)
  enable_standby     = true
  enable_bastion     = false
  admin_ssh_keys     = ["ssh-ed25519 AAAA... operator-1"]
  admin_source_cidrs = ["198.51.100.10/32"] # the operators' fixed addresses; never 0.0.0.0/0
  backup_storage_accounts = {
    repo1 = "scfbackuprepo1x"
    repo2 = "scfbackuprepo2x"
  }
  dns_zones        = ["ingest-domain-one.example", "ingest-domain-two.example"]
  ingest_hostnames = ["ingest.ingest-domain-one.example", "ingest.ingest-domain-two.example"]
  portal_hostname  = "app.ingest-domain-one.example"
  status_hostname  = "" # optional, e.g. "status.ingest-domain-one.example"
  # One exact published version (never "latest"):
  #   az vm image list --publisher Debian --offer debian-13 --sku 13-gen2 --all -o table
  image = { version = "0.20261101.2290" }
}
