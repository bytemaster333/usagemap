#cloud-config
# SPDX-License-Identifier: Apache-2.0
# First boot only: enough for Ansible to take over (infra/ansible, ADR-0019). No secrets here — custom data is
# readable by anyone with read access to the VM resource.
hostname: ${node_name}
preserve_hostname: false
package_update: true
packages: [python3, nftables]
write_files:
  - path: /etc/scf/node.env
    permissions: "0644"
    content: |
      SCF_NODE_NAME=${node_name}
      SCF_NODE_CLASS=${class}
  - path: /etc/ssh/sshd_config.d/10-scf.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
%{ if class == "edge" ~}
  # Edge nodes: no core dumps (C-66 / ADR-0019: the daily ingest key lives in their memory).
  - path: /etc/sysctl.d/10-scf-nocore.conf
    permissions: "0644"
    content: |
      kernel.core_pattern=|/bin/false
      fs.suid_dumpable=0
%{ endif ~}
runcmd:
  - [systemctl, restart, ssh]
%{ if class == "edge" ~}
  - [sysctl, --system]
  - [swapoff, -a]
%{ endif ~}
