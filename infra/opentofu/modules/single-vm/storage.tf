# SPDX-License-Identifier: Apache-2.0
# Backup repository (C-108, C-110, C-112): one storage account, container `pgbackrest` (pgBackRest repository 2, WAL
# archive, weekly logical dumps under dumps/). Repository 1 of the v1 shape is a local pgBackRest repository on the
# VM's disk (fast point-in-time restores); this account is the off-host copy.
#
# Protection model: versioning on; the VM writes with a container-scoped SAS (racwdl: read, add, create, write,
# delete CURRENT blobs, list) generated by the operator outside OpenTofu — WITHOUT `x` (delete version) and `y`
# (permanent delete) — so a compromised VM only turns blobs into previous versions, which the lifecycle rule deletes
# after 14 days (the erasure bound, C-112). Shared keys stay enabled only because a SAS is signed with one; the key
# itself never leaves the operator's workstation. Network: the VM subnet's service endpoint and the operators'
# addresses only.

resource "azurerm_storage_account" "backup" {
  name                     = var.backup_storage_account
  location                 = var.location
  resource_group_name      = data.azurerm_resource_group.rg.name
  account_kind             = "StorageV2"
  account_tier             = "Standard"
  account_replication_type = "LRS"
  access_tier              = var.backup_access_tier

  min_tls_version                  = "TLS1_2"
  https_traffic_only_enabled       = true
  allow_nested_items_to_be_public  = false
  shared_access_key_enabled        = true # signs the container SAS; see above
  cross_tenant_replication_enabled = false

  blob_properties {
    versioning_enabled = true
    delete_retention_policy {
      days = var.backup_previous_version_days
    }
    container_delete_retention_policy {
      days = var.backup_previous_version_days
    }
  }

  network_rules {
    default_action             = "Deny"
    bypass                     = ["None"]
    ip_rules                   = [for c in var.admin_source_cidrs : trimsuffix(c, "/32")]
    virtual_network_subnet_ids = [azurerm_subnet.app.id]
  }

  tags = merge(local.tags, { purpose = "pgbackrest" })

  lifecycle {
    prevent_destroy = true # the backups; removing them is a deliberate, manual decision
  }
}

resource "azurerm_storage_container" "pgbackrest" {
  name                  = "pgbackrest"
  storage_account_id    = azurerm_storage_account.backup.id
  container_access_type = "private"

  lifecycle {
    prevent_destroy = true
  }
}

# Previous versions are deleted after 14 days; current blobs are never touched by a rule (S-08 O10).
resource "azurerm_storage_management_policy" "backup" {
  storage_account_id = azurerm_storage_account.backup.id

  rule {
    name    = "delete-previous-versions"
    enabled = true
    filters {
      blob_types = ["blockBlob"]
    }
    actions {
      version {
        delete_after_days_since_creation = var.backup_previous_version_days
      }
    }
  }
}
