# Outputs consumed by the deploy procedure (docs/guides/deploy-v1.md) and infra/ansible. No secret is output.

output "app" {
  description = "The VM: name, admin user, front-end addresses (public and the private ones Docker publishes on)."
  value = {
    name              = var.vm.name
    admin_username    = var.admin_username
    ingest_public_ip  = azurerm_public_ip.front["ingest"].ip_address
    portal_public_ip  = azurerm_public_ip.front["portal"].ip_address
    ingest_private_ip = local.ip_ingest
    portal_private_ip = local.ip_portal
    subnet            = local.subnet
  }
}

output "drill_vms" {
  description = "Temporary drill VMs: name → public and private address."
  value       = { for n, _ in var.drill_vms : n => { public_ip = azurerm_public_ip.drill[n].ip_address, private_ip = local.drill_ips[n] } }
}

output "backup" {
  description = "Backup storage account and container (the SAS is generated by the operator, never by OpenTofu)."
  value = {
    account   = azurerm_storage_account.backup.name
    container = azurerm_storage_container.pgbackrest.name
    endpoint  = azurerm_storage_account.backup.primary_blob_endpoint
  }
}
