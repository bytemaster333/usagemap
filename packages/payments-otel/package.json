{
  "name": "@usagemap/payments-otel",
  "version": "0.1.0",
  "description": "OpenTelemetry metrics for agent payments on the server side (x402 resource servers and MPP via mppx): payment required, verified, settled, failed and canceled counts with closed reason classes, never payers, recipients, amounts, transaction hashes or credentials.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:example": "PAYMENTS_OTEL_EXAMPLE=1 vitest run test/example-x402.test.ts"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2.0.0",
    "@x402/core": ">=2.31.0 <3.0.0",
    "mppx": ">=0.19.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": true
    },
    "mppx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@types/node": "24.19.2",
    "@x402/core": "2.31.0",
    "@x402/stellar": "2.31.0",
    "mppx": "0.19.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
