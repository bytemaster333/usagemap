{
  "name": "@usagemap/anchor-otel",
  "version": "0.1.0",
  "description": "OpenTelemetry metrics for the wallet side of Stellar anchor flows (SEP-1/6/10/12/24/31/38) through SDF's Wallet SDK or any axios client: step latency, outcome class and funnel events per anchor home domain; never amounts, accounts, memos, KYC fields, tokens or URLs.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2.0.0",
    "@stellar/typescript-wallet-sdk": ">=6.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/typescript-wallet-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@stellar/stellar-sdk": "17.4.0",
    "@stellar/typescript-wallet-sdk": "6.0.0",
    "@types/node": "24.19.2",
    "axios": "1.20.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
