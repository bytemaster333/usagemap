{
  "name": "@usagemap/edge-otel",
  "version": "0.1.0",
  "description": "Zero-dependency UsageMap API analytics for fetch-handler runtimes (Cloudflare Workers, Vercel Edge / Next.js route handlers, Deno, Bun): http.server.request.duration with route templates as OTLP/HTTP JSON.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:conformance": "cd conformance && GOWORK=off go test -count=1 ./..."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
