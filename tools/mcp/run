#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# UsageMap MCP server (plan E8). Node standard library only.
#
#   tools/mcp/run serve       stdio MCP server (env: USAGEMAP_API_URL, USAGEMAP_OPERATOR_KEY_FILE, USAGEMAP_SHARE_KEY_FILE)
#   tools/mcp/run selftest    protocol and tool tests against a mock API (no network)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cmd="${1:-}"; [ $# -gt 0 ] && shift
case "${cmd}" in
  serve) exec node "${here}/server.ts" "$@" ;;
  selftest) cd "${here}/../.."; if command -v mise >/dev/null 2>&1; then eval "$(mise env -s bash)"; fi; node --test "$@" "${here}"/test/*.test.ts ;;
  *) sed -n '3,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
