# Code generated by apps/portal/scripts/gen-caddy.ts from apps/portal/server/headers.ts. DO NOT EDIT.
# Security headers for a portal served over https (imported by server/Caddyfile).
header {
	defer
	-Server
	-X-Powered-By
	Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://horizon-testnet.stellar.org https://horizon.stellar.org; manifest-src 'self'; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "no-referrer"
	Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(self), publickey-credentials-create=(self), publickey-credentials-get=(self)"
	Cross-Origin-Opener-Policy "same-origin"
	Cross-Origin-Resource-Policy "same-origin"
	X-Frame-Options "DENY"
	Origin-Agent-Cluster "?1"
	Strict-Transport-Security "max-age=63072000; includeSubDomains"
}
