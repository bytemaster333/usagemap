{
  "name": "@usagemap/portal",
  "version": "0.1.0",
  "description": "Tenant and SCF-operator portal: static Vite + React SPA over the control-plane API (ADR-0024).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "node scripts/gen-definitions.ts && vite build",
    "dev": "vite",
    "gen:caddy": "node scripts/gen-caddy.ts",
    "check:generated": "node scripts/gen-caddy.ts --check && node scripts/gen-definitions.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "node scripts/gen-caddy.ts --check && node scripts/gen-definitions.ts --check && vitest run",
    "test:e2e": "node scripts/gen-definitions.ts && vite build && playwright test -c playwright.config.ts",
    "test:e2e:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@usagemap/api-types": "workspace:*",
    "@stellar/freighter-api": "6.0.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
