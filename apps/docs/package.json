{
  "name": "@usagemap/docs",
  "version": "0.1.0",
  "description": "UsageMap end-user documentation (usagemap.dev/docs): Fumadocs on Next.js, exported as static HTML.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node scripts/copy-skill.ts && next dev -p 3310",
    "build": "node scripts/copy-skill.ts && next build",
    "start": "node scripts/serve.ts",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "biome check ."
  },
  "dependencies": {
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.3",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
