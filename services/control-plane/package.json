    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
