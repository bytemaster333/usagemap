{
  "name": "@usagemap/control-plane",
  "version": "0.1.0",
  "description": "Control plane: sign-in, tenants, sites, signed edge snapshot, internal edge API (ADR-0014/0015/0016).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./workers": "./src/workers/start.ts"
  },
  "engines": {
