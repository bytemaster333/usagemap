#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Hosted UsageMap MCP server (Streamable HTTP). Node standard library only; shares its tools with tools/mcp.
#
#   services/mcp/run serve    HTTP server (env: MCP_CONTROL_PLANE_URL, MCP_LISTEN_HOST, MCP_PORT, … see src/config.ts)
#   services/mcp/run test     unit + HTTP integration tests (API keys and OAuth) against mock control planes (no network)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cmd="${1:-}"; [ $# -gt 0 ] && shift
case "${cmd}" in
  serve) exec node "${here}/main.ts" "$@" ;;
  test) cd "${here}/../.."; if command -v mise >/dev/null 2>&1; then eval "$(mise env -s bash)"; fi; node --test "$@" "${here}"/test/*.test.ts ;;
  *) sed -n '3,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
